# Copy to /opt/passvault/passvault.env (chmod 600, owned by the passvault
# user) and fill in.
PASSVAULT_DB_DSN=postgres://passvault:REPLACE_ME@127.0.0.1:5432/passvault?sslmode=disable

# Gates /v1/admin/* (invite creation, disabling accounts) — this is YOUR
# operator credential, not shared with users. Generate with:
#   openssl rand -hex 32
PASSVAULT_ADMIN_TOKEN=REPLACE_ME

PASSVAULT_LISTEN=127.0.0.1:8098
PASSVAULT_WEB_DIR=/opt/passvault/web

# Where encrypted attachment files live on disk — never served directly,
# always through the ownership-checked /v1/attachments/{id} route. Back
# this up alongside the database (it's the other half of the data).
PASSVAULT_ATTACHMENTS_DIR=/opt/passvault/attachments

# Where encrypted Send file content lives on disk (see docs/PROTOCOL.md's
# Send section) — a separate directory from attachments since Sends expire
# and get swept automatically; attachments don't. No need to back this up
# as carefully — anything in here is, by design, meant to disappear.
PASSVAULT_SENDS_DIR=/opt/passvault/sends

# false (default, recommended) = invite-only signup, matching Vaultwarden's
# own safer default. Set true only if you want anyone who reaches this
# server to be able to create an account with no invite.
PASSVAULT_SIGNUPS_ALLOWED=false
